# 统一换行符处理，避免 Windows / Linux 混合协作时的整文件 diff
* text=auto

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本与配置保持 LF
*.sh  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不做文本转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.jar  binary
*.apk  binary
